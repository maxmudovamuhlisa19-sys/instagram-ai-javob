# ====== Bu faylni ".env" deb nusxalab, o'z qiymatlaringizni yozing ======

# Webhook tasdiqlash tokeni — Meta'da kiritganingiz bilan bir xil bo'lishi kerak.
# Ixtiyoriy matn tanlang, masalan: 3x7Kd92mQ1
VERIFY_TOKEN=BU_YERGA_TOKEN_YOZING

# Facebook Page Access Token (instagram_manage_messages huquqi bilan)
PAGE_ACCESS_TOKEN=BU_YERGA_PAGE_TOKEN_YOZING

# OpenAI API kaliti (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Sizning Instagram business akkauntingiz ID raqami (ixtiyoriy, lekin tavsiya)
# Webhook log'larida "recipient" id si sifatida ko'rinadi.
IG_USER_ID=

# Quyidagilarni o'zgartirish shart emas:
PORT=8000
OPENAI_MODEL=gpt-4o-mini
GRAPH_VERSION=v20.0

# Botning AI shaxsiyati (ixtiyoriy)
SYSTEM_PROMPT=Sen foydalanuvchiga Instagram orqali javob beruvchi do'stona, qisqa va tushunarli o'zbek tilidagi yordamchisan. Hech qachon dastur yoki AI ekanligini oshkor qilmaysan. Foydalanuvchi savoliga qisqa, aniq javob ber. Kerak bo'lsa, aniqrog'ini so'rayver.
